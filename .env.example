# ---- Download ----
# MUST be a DIRECT link to the .apk file (a link that downloads the file), not an Expo build page.
# An Expo build page like https://expo.dev/accounts/<you>/projects/tedoku/builds/<id> opens a web page.
# Get the direct file URL from the Expo build page ("Download" -> copy link) or host the APK in Supabase Storage / R2 / GitHub Releases.
APK_URL=https://expo.dev/accounts/george-0zoemena/projects/tedoku/builds/5992c416-25e0-4e05-9840-9f897b72acf6

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Privacy / tracking ----
# Long random string. Used to salt the daily IP hash. Never commit the real value.
IP_HASH_SALT=change-me-to-a-long-random-string
# Protects the retention cron route: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me-too

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Admin ----
# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS=detechbishop@gmail.com,teammate@example.com
